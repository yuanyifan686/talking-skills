# Copy required values to your runtime environment. Never commit real secrets.
TALKING_SKILLS_NETWORK=optional
TALKING_SKILLS_LOCAL_TTS_COMMAND_JSON=
TALKING_SKILLS_RUNTIME_URL=http://127.0.0.1:8765

# TTS routing: local CosyVoice first, Seed Audio and legacy Volcengine TTS as cloud fallbacks.
TTS_PROVIDER=auto
COSYVOICE_TTS_ENDPOINT=
COSYVOICE_TTS_TOKEN=
COSYVOICE_TTS_VOICE=
COSYVOICE_TTS_COMMAND_JSON=

# ByteDance Seed Audio 1.0. Keep the API key in the environment only.
BYTEDANCE_SEED_AUDIO_API_KEY=replace_with_a_new_key
BYTEDANCE_SEED_AUDIO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/create
BYTEDANCE_SEED_AUDIO_MODEL=seed-audio-1.0
BYTEDANCE_SEED_AUDIO_WATERMARK_JSON={}

# Default LLM provider (Volcengine Ark). The Runtime also accepts ARK_API_KEY
# and ARK_ENDPOINT_ID aliases. Never commit real values.
VOLCENGINE_API_KEY=
VOLCENGINE_ENDPOINT_ID=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

VOLCENGINE_TTS_ENDPOINT=
VOLCENGINE_TTS_TOKEN=
VOLCENGINE_TTS_APP_ID=
VOLCENGINE_TTS_CLUSTER=volcano_tts
VOLCENGINE_TTS_VOICE=

OPENAI_API_KEY=
OPENAI_TTS_ENDPOINT=https://api.openai.com/v1/audio/speech
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
