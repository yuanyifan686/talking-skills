{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talking-skills.local/schemas/optimization.schema.json",
  "title": "Score-Driven Spoken Script Optimization",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_script", "scorecard", "optimized_script", "mode", "target_dimensions", "changes"],
  "$defs": {
    "dimension": {
      "enum": [
        "interrupt_prediction",
        "reward_expectation",
        "loss_aversion",
        "precise_naming",
        "replicability",
        "no_fluff",
        "ai_adaptability",
        "emotional_intensity",
        "memorability",
        "shareability"
      ]
    }
  },
  "properties": {
    "source_title": {"type": ["string", "null"]},
    "optimized_title": {"type": ["string", "null"]},
    "source_script": {"type": "string", "minLength": 1},
    "scorecard": {"$ref": "score.schema.json"},
    "optimized_script": {"type": "string", "minLength": 1},
    "mode": {"enum": ["polish", "surgical", "rewrite"]},
    "target_dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/dimension"}
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "before_quote", "after_quote", "reason"],
        "properties": {
          "dimension": {"$ref": "#/$defs/dimension"},
          "before_quote": {"type": "string", "minLength": 1},
          "after_quote": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 4},
          "technique": {"type": "string"}
        }
      }
    },
    "preserved_constraints": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_characters", "optimized_characters", "estimated_duration", "similarity", "change_ratio"],
      "properties": {
        "source_characters": {"type": "integer", "minimum": 1},
        "optimized_characters": {"type": "integer", "minimum": 1},
        "estimated_duration": {"type": "number", "exclusiveMinimum": 0},
        "similarity": {"type": "number", "minimum": 0, "maximum": 1},
        "change_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}

