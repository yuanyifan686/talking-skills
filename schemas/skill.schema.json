{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talking-skills.local/schemas/skill.schema.json",
  "title": "Talking Skill Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "version", "description", "capabilities", "actions", "inputs", "outputs", "requirements", "execution_modes"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "protocol_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 10},
    "category": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "states": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inputs": {"type": "object"},
    "outputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "interactive": {"type": "boolean"},
    "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "requirements": {
      "type": "object",
      "required": ["runtime", "binaries", "permissions", "external_services"],
      "properties": {
        "runtime": {"type": "array", "items": {"type": "string"}},
        "binaries": {"type": "array", "items": {"type": "string"}},
        "permissions": {"type": "object"},
        "external_services": {"type": "object"}
      }
    },
    "execution_modes": {
      "type": "array",
      "items": {"enum": ["full", "partial", "text_only"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "schemas": {"type": "object", "additionalProperties": {"type": "string"}},
    "references": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
